{
  "manifest_version": 3,
  "name": "Vanya Downloader — Browser Integration",
  "version": "1.1.2",
  "description": "IDM-style video and song download bar & automatic download interception for Vanya Downloader.",
  "permissions": [
    "contextMenus",
    "downloads",
    "activeTab",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:18792/*",
    "http://localhost:18792/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.png"
  }
}
